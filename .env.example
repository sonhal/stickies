# Copy to .env and fill in. Never commit .env.

# ── GitLab ──────────────────────────────────────────────────────────────
# Your GitLab instance (no trailing slash): gitlab.com or self-managed.
GITLAB_URL=https://gitlab.com
# Group ID (number) or full path, e.g. 1234567 or my-company/my-team
GITLAB_GROUP=my-company/my-team
# Optional: only include items that have ALL of these labels (comma separated titles)
# GITLAB_LABEL_FILTER=team::platform
# 'group' (default): one group.workItems(includeDescendants) query.
# 'projects': one query per project. Use it if scripts/introspect.ts says the group query
# doesn't return project issues on your GitLab.
# GITLAB_ITEMS_MODE=group

# ── User sign-in (GitLab OAuth) ─────────────────────────────────────────
# Create an application in GitLab: Group → Settings → Applications
#   Redirect URI:  https://<your board>/auth/callback   (http://localhost:5173/auth/callback for dev)
#   Confidential:  yes
#   Scopes:        api   (only this one; the board refuses tokens whose scope isn't exactly api)
# Why api: editing issues needs a write scope and GitLab has none limited to issues.
# The board only sends two allowlisted mutations built from validated input; see README.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# Encrypts the session cookie (which holds each user's GitLab token).
# At least 32 characters. Generate with:  openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=
# How long someone stays signed in before logging in again (days, default 1).
# Kept short because every session carries an api-scope token.
# SESSION_MAX_AGE_DAYS=1

# ── Kiosk screen (optional, always read-only) ───────────────────────────
# For a wall screen nobody signs in on. Open /kiosk/<KIOSK_KEY> on it once;
# it then shows what GITLAB_TOKEN can see, for 30 days.
# GITLAB_TOKEN: a group access token with ONLY the read_api scope, Reporter role, with an expiry
#   date. The board checks the scope and refuses to load the kiosk with a broader token.
# KIOSK_KEY: at least 24 characters. Generate with:  openssl rand -base64 32 | tr '+/' '-_'
# GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# KIOSK_KEY=
# Config view ids the kiosk shows (from src/lib/views.config.ts), comma separated
# KIOSK_VIEWS=standup
# Switch to the next kiosk view every N seconds (0 = stay on the first)
# KIOSK_ROTATE_SECONDS=0

# ── Data & limits ───────────────────────────────────────────────────────
# Seconds the server reuses a viewer's items before refetching (default 30)
# CACHE_SECONDS=30
# Seconds the server reuses a viewer's field schema: custom fields, statuses, projects… (default 600)
# SCHEMA_CACHE_SECONDS=600
# Closed items older than this many days are not fetched (default 30)
# CLOSED_DAYS_MAX=30
# Writes per signed-in user per minute (default 60)
# WRITE_RATE_PER_MINUTE=60

# adapter-node settings used by `npm start`. ORIGIN must be the public URL: it is used
# to build the OAuth redirect URI and for the same-origin checks on writes and sign-out.
# PORT=3000
# ORIGIN=https://board.internal.example.com
