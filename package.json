{
	"name": "board",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Linear-style views (list, board, Eisenhower matrix) over GitLab work items",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"introspect": "node scripts/introspect.ts",
		"fake-gitlab": "node scripts/fake-gitlab.mjs",
		"smoke": "node tests/smoke.cjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.3.0",
		"@sveltejs/kit": "^2.43.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/node": "^22.20.5",
		"graphql": "^16.11.0",
		"svelte": "^5.39.0",
		"svelte-check": "^4.3.0",
		"typescript": "^5.9.0",
		"vite": "^7.1.0",
		"vitest": "^3.2.0"
	},
	"engines": {
		"node": ">=20.19"
	},
	"dependencies": {
		"lz-string": "^1.5.0",
		"valibot": "^1.5.0"
	}
}
